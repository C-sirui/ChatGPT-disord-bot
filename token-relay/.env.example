# ---- required in production ----
TR_ENV=production
# 32 random bytes, base64:  node dist/cli.js gen-master-key
TR_MASTER_KEY=
DATABASE_URL=postgres://relay:relay@localhost:5432/relay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- optional ----
# Admin/debug token (>= 24 chars required if debug is enabled in production)
TR_ADMIN_TOKEN=
TR_SERVER__PUBLIC_BASE_URL=https://relay.example.com
TR_SERVER__TRUST_PROXY=true
TR_LOG__LEVEL=info

# Only after legal review of each provider's reseller terms (DESIGN.md §3, O1):
# TR_PROVIDERS__OPENAI_COMPATIBLE__RESALE_ACKNOWLEDGED=true

# Any config key can be overridden: TR_<SECTION>__<KEY>=<json or string>
# e.g. TR_PRICING__TAKE_RATE=0.15   TR_RELAY__MAX_ATTEMPTS=4

# ---- docker-compose.pi.yml only ----
# POSTGRES_PASSWORD=
# CLOUDFLARE_TUNNEL_TOKEN=
# DATA_DIR=/mnt/ssd/token-relay
